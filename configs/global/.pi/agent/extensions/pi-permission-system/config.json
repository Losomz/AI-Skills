{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/pi-permission-system-v24.0.0/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "ask"
    },
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "dd *": "ask",
      "mv *": "ask",
      "find *-delete*": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "sudo *": "ask",
      "su *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "reboot *": "ask",
      "shutdown *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git restore *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git branch -D *": "ask",
      "git tag -d *": "ask",
      "git stash drop *": "ask",
      "git stash clear *": "ask",
      "git stash pop *": "ask",
      "git worktree remove *": "ask",
      "git commit *--amend*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push *--force*": "ask",
      "git push *--delete*": "ask",
      "bash *": "ask",
      "sh *": "ask",
      "zsh *": "ask",
      "eval *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "rd *": "ask",
      "format *": "ask",
      "diskpart *": "ask",
      "taskkill *": "ask",
      "reg delete *": "ask",
      "sc delete *": "ask",
      "powershell *": "ask",
      "powershell.exe *": "ask",
      "pwsh *": "ask",
      "cmd /c *": "ask",
      "cmd.exe /c *": "ask"
    }
  }
}
