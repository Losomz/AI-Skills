  "license": "MIT",
  "author": "Losomz",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "agent-workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losomz/AgentFramework.git",
    "directory": "packages/picraft"
  },
  "homepage": "https://github.com/Losomz/AgentFramework/tree/main/packages/picraft#readme",
  "bugs": {
    "url": "https://github.com/Losomz/AgentFramework/issues"
  },
  "files": [
    "extensions/plan",
    "extensions/questionnaire",
    "extensions/subagent",
    "extensions/git",
    "extensions/init",
    "extensions/blog",
    "extensions/permission",
    "extensions/mcp",
    "extensions/shared",
    "skills",
    "prompts",
    "themes"
